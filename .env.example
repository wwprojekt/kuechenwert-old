# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ----- App -----
# Primäre Website-Domain (mit Umlaut). Punycode: xn--kchenwert-q9a.de
NEXT_PUBLIC_SITE_URL=https://küchenwert.de
CRON_SECRET=change-me-cron-secret
INVOICE_SIGN_SECRET=change-me-invoice-secret

# ----- E-Mail (Resend, https://resend.com/api-keys) -----
# Mail-Domain ist bewusst `kuechenwert24.de` (ASCII), NICHT küchenwert.de:
# - Umlaut-Domains in From/To bereiten SPF/DKIM/DMARC + Spamfilter-Probleme.
# - `kuechenwert.de` (ohne Umlaut) gehört uns NICHT (fremder Domain-Park).
RESEND_API_KEY=re_...
EMAIL_FROM="KüchenWert <info@kuechenwert24.de>"
EMAIL_BCC_BUCHHALTUNG=buchhaltung@kuechenwert24.de

# ----- Firmen-Stammdaten (auf Rechnungen / Impressum) -----
COMPANY_NAME="WohnWert GmbH"
COMPANY_BRAND="KüchenWert"
COMPANY_ADDRESS="Hannoversche Str. 106"
COMPANY_POSTAL_CODE=30627
COMPANY_CITY=Hannover
COMPANY_COUNTRY=Deutschland
COMPANY_REGISTER_COURT="Amtsgericht Hannover"
COMPANY_REGISTER_NO="HRB 230114"
COMPANY_DIRECTOR="Mona Kareem-Ameen"
COMPANY_EDITOR="Mona Kareem-Ameen"
COMPANY_PHONE="0511 5153247"
COMPANY_EMAIL="info@kuechenwert24.de"
COMPANY_EMAIL_ASCII="info@kuechenwert24.de"
COMPANY_VAT_ID="Beantragt"

# ----- Bankverbindung -----
COMPANY_BANK_HOLDER="WohnWert GmbH"
COMPANY_BANK_IBAN="DE75 2519 3331 1192 0580 00"
COMPANY_BANK_BIC="GENODEF1PAT"
COMPANY_BANK_NAME="Volksbank eG"

# ================================================================
# KI-Traumkueche Funnel (Funnel C)
# ================================================================

# ----- Fal.ai (FLUX.1 [pro] Image-Generation) -----
# Erstellen: https://fal.ai/dashboard/keys
# Format: <keyId>:<secret>. Wenn nicht gesetzt, laeuft der Planer
# im Mock-Modus und liefert Platzhalter-Bilder (fuer Dev/Smoke).
FAL_KEY=

# Optional: alternatives Modell fuer A/B-Tests oder Kostenreduktion
# z.B. fal-ai/flux/dev (billiger, niedrigere Qualitaet)
FAL_MODEL_SLUG=fal-ai/flux-pro/v1.1

# ----- Cloudflare Turnstile (Bot-Schutz Lead-Gate) -----
# https://dash.cloudflare.com/?to=/:account/turnstile
# Wenn nicht gesetzt -> fail-open fuer Dev. Production MUSS beide setzen.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ----- Analytics (Client-seitig, Consent-gated) -----
# Meta Pixel: https://business.facebook.com/events_manager2
NEXT_PUBLIC_META_PIXEL_ID=
# Google Analytics 4 Measurement ID (G-XXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ----- Server-seitige Conversion-APIs (fuer Ad-Attribution) -----
# Meta Conversions API Token (Events Manager -> Settings -> Conversions API)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Google Measurement Protocol fuer GA4 (Admin -> Data Streams -> Measurement Protocol)
GA_MEASUREMENT_ID=
GA_MEASUREMENT_API_SECRET=

# ----- Supabase Storage Bucket -----
# Renderings werden in den existierenden `lead-files`-Bucket geschrieben
# unter dem Pfad `planner/{sessionId}/v{version}.jpg`. Kein separater Bucket noetig.
